<Window x:Class="ClearFolder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClearFolder"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:forms="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal" 
        TextOptions.TextRenderingMode="Auto" 
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Clear Folder" SizeToContent="WidthAndHeight">

    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignPaperButton}">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <DataTemplate DataType="{x:Type forms:ProgressBar}">
            <StackPanel Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <ProgressBar Style="{DynamicResource MaterialDesignCircularProgressBar}" 
                             HorizontalAlignment="Center" Margin="16" 
                             IsIndeterminate="True" Value="0" />
                <TextBlock Width="400" Text="{Binding DataContext.ProgressStatus, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Margin="16"  HorizontalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <system:Boolean x:Key="MoveToRecycleBin">False</system:Boolean>
        <system:Boolean x:Key="DeletePermanently">True</system:Boolean>
        <system:Int32 x:Key="DaysChange1">1</system:Int32>
        <system:Int32 x:Key="DaysChange10">10</system:Int32>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="RootDialog">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="20 0 0 0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">

                <StackPanel.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignToolButton}">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </StackPanel.Resources>

                <Label Margin="10 20" 
                       Content="Days back"/>
                <Button Margin="5"
                        Content="&lt;&lt;" 
                        Command="{Binding DecreaseDaysCommand}"
                        CommandParameter="{StaticResource DaysChange10}"
                        Click="ButtonDecrease_OnClick"
                        ToolTip="Decrease 10 days" />
                <Button Margin="5"
                        Content="&lt;" 
                        Command="{Binding DecreaseDaysCommand}"
                       CommandParameter="{StaticResource DaysChange1}"
                        Click="ButtonDecrease_OnClick"
                        ToolTip="Decrease 1 day" />
                <TextBox Margin="10 20"
                     VerticalAlignment="Center"  HorizontalAlignment="Left"
                     Text="{Binding DaysBack}"
                     IsReadOnly="True"/>
                <Button Margin="5"
                        Content="&gt;" 
                        Command="{Binding IncreaseDaysCommand}"
                        CommandParameter="{StaticResource DaysChange1}"
                        Click="ButtonIncrease_OnClick"
                        ToolTip="Increase 1 day" />
                <Button Margin="5"
                        Content="&gt;&gt;" 
                        Command="{Binding IncreaseDaysCommand}"
                        CommandParameter="{StaticResource DaysChange10}"
                        Click="ButtonIncrease_OnClick"
                        ToolTip="Increase 10 day" />
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2"
                        VerticalAlignment="Center">

                <StackPanel.Resources>
                    <Style TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignAccentRadioButton}">
                        <Setter Property="Command" Value="{Binding ChangeDeleteType}"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="2"/>
                    </Style>
                </StackPanel.Resources>

                <RadioButton IsChecked="True" Content="Send to Recycle Bin" CommandParameter="{StaticResource MoveToRecycleBin}"/>
                <RadioButton Content="Delete Permanently" CommandParameter="{StaticResource DeletePermanently}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Vertical" HorizontalAlignment="Center">
                <Label Content="Recycle Bin"/>
                <StackPanel  VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                    <StackPanel.Resources>
                        <ImageBrush x:Key="AddButtonImageBrush" ImageSource="/download.ico" Stretch="UniformToFill"/>
                    </StackPanel.Resources>
                    <Button Background="{StaticResource AddButtonImageBrush}" HorizontalAlignment="Center" ToolTip="Empty Recycle Bin"
                        Command="{Binding EmptyRecycleBin}" IsEnabled="{Binding RecycleEnabled}"/>
                    <StackPanel Orientation="Vertical">
                        <Label Content="{Binding RecycleCount, UpdateSourceTrigger=PropertyChanged}" Margin="5 0"/>
                        <Label Content="{Binding RecycleSize, UpdateSourceTrigger=PropertyChanged}" Margin="5 0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <DataGrid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                  Margin="20 0"
                  ItemsSource="{Binding FoldersCollection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsSynchronizedWithCurrentItem="True"
                  GridLinesVisibility="None"
                  SelectedItem="{Binding SelectedFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                <DataGrid.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatAccentButton}"/>
                    <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns >
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridCheckBoxColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <EventSetter Event="CheckBox.Click" Handler="IsSelectedClick"/>
                                <Setter Property="IsEnabled" Value="{Binding SelectEnabled}"/>
                            </Style>
                        </DataGridCheckBoxColumn.CellStyle>
                    </DataGridCheckBoxColumn>

                    <DataGridTextColumn Header="Folder" IsReadOnly="True" Binding="{Binding Name}"/>

                    <DataGridTextColumn Header="Delete Files" Binding="{Binding DeleteFilesCount}" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Size" Binding="{Binding DeleteFilesSize}" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenSelectedFolder , RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Content="Open"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="3" Grid.Column="1" Margin="25 0"
                    Orientation="Horizontal" VerticalAlignment="Center">
                <Button Margin="5"
                    Content="+" 
                    Command="{Binding AddFolderCommand}"
                    ToolTip="Add Folder"/>
                <Button Margin="5"
                    Content="-" 
                    Command="{Binding DeleteFolderCommand}"
                    ToolTip="Remove selected Folder"/>
                <Label Margin="20 0" Content="{Binding DeleteFilesInfo}" VerticalContentAlignment="Center"/>
            </StackPanel>
            <Button Grid.Row="3" Grid.Column="2" Margin="20"
                Content="Clear Folders"
                IsEnabled="{Binding ClearButtonEnabled}"
                Command="{Binding ClearFolderCommand}"
                ToolTip="Clear files from selected Folder"/>
        </Grid>
    </materialDesign:DialogHost>
</Window>
