<Window x:Class="ClearFolder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClearFolder"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:forms="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="14"
        TextOptions.TextFormattingMode="Ideal" 
        TextOptions.TextRenderingMode="Auto" 
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Clear Folder" SizeToContent="WidthAndHeight">

    <Window.DataContext>
        <local:MainWindowViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <local:MainWindowViewModel x:Key="ViewModel" />
        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignPaperButton}">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <DataTemplate DataType="{x:Type forms:ProgressBar}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <ProgressBar Style="{DynamicResource MaterialDesignCircularProgressBar}" 
                             Width="30" Height="30" HorizontalAlignment="Center" Margin="16" 
                             IsIndeterminate="True" Value="0" />
                <TextBlock Text="Delete files, please wait..." Style="{StaticResource MaterialDesignSubtitle2TextBlock}" Margin="16"  HorizontalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <system:Boolean x:Key="MoveToRecycleBin">False</system:Boolean>
        <system:Boolean x:Key="DeletePermanently">True</system:Boolean>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="RootDialog">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="20" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="20 0 0 0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Stretch">
                <Label Margin="10 20" 
                   Content="Days back"/>
                <TextBox Margin="0,20,20,20"
                     VerticalAlignment="Center"  HorizontalAlignment="Left"
                     Text="{Binding DaysBack}"
                     IsReadOnly="True"/>
                <Button Margin="5"
                        Content="-" 
                        Command="{Binding DecreaseDaysCommand}"
                        Click="ButtonDecrease_OnClick"
                        ToolTip="Decrease days" />
                <Button Margin="5"
                        Content="+" 
                        Command="{Binding IncreaseDaysCommand}"
                        Click="ButtonIncrease_OnClick"
                        ToolTip="Increase days"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2"
                        VerticalAlignment="Center">

                <StackPanel.Resources>
                    <Style TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignAccentRadioButton}">
                        <Setter Property="Command" Value="{Binding ChangeDeleteType}"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="2"/>
                    </Style>
                </StackPanel.Resources>

                <RadioButton IsChecked="True" Content="Send to Recycle Bin" CommandParameter="{StaticResource MoveToRecycleBin}"/>
                <RadioButton Content="Delete Permanently" CommandParameter="{StaticResource DeletePermanently}"/>
            </StackPanel>

            <DataGrid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                  Margin="20 0"
                  ItemsSource="{Binding FoldersCollection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsSynchronizedWithCurrentItem="True"
                  SelectedItem="{Binding SelectedFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                <DataGrid.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatAccentButton}"/>
                    <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns >
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <DataGridTemplateColumn Header="Folder">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" >
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="ToolTip" Value="{Binding ToolTipText, Mode=TwoWay}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.OpenSelectedFolder , RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Content="Open"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="3" Grid.Column="1" Margin="25 0"
                    Orientation="Horizontal">
                <Button Margin="5"
                    Content="+" 
                    Command="{Binding AddFolderCommand}"
                    ToolTip="Add Folder"/>
                <Button Margin="5"
                    Content="-" 
                    Command="{Binding DeleteFolderCommand}"
                    ToolTip="Remove selected Folder"/>
            </StackPanel>
            <Button Grid.Row="3" Grid.Column="2" Margin="20"
                Content="Clear Folders"
                Command="{Binding ClearFolderCommand}"
                ToolTip="Clear files from selected Folder"/>
        </Grid>
    </materialDesign:DialogHost>
</Window>
